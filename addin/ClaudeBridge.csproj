<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <RobotStudioDir Condition="'$(RobotStudioDir)' == ''">D:\Program Files (x86)\ABB Industrial IT\Robotics IT\RobotStudio 6.08</RobotStudioDir>
    <NewtonsoftJsonPath Condition="'$(NewtonsoftJsonPath)' == ''">$(RobotStudioDir)\Bin\Addins\ConveyorTrackingModuleAddin\Newtonsoft.Json.dll</NewtonsoftJsonPath>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\.packages</RestorePackagesPath>
    <AssemblyName>ClaudeBridge</AssemblyName>
    <RootNamespace>ClaudeBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ABB.Robotics.RobotStudio">
      <HintPath>$(RobotStudioDir)\Bin\ABB.Robotics.RobotStudio.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.RobotStudio.Stations">
      <HintPath>$(RobotStudioDir)\Bin\ABB.Robotics.RobotStudio.Stations.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.RobotStudio.Controllers">
      <HintPath>$(RobotStudioDir)\Bin\ABB.Robotics.RobotStudio.Controllers.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.Controllers.PC">
      <HintPath>$(RobotStudioDir)\Bin\ABB.Robotics.Controllers.PC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.Math">
      <HintPath>$(RobotStudioDir)\Bin\ABB.Robotics.Math.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.RobotStudio.Environment">
      <HintPath>$(RobotStudioDir)\Bin\ABB.Robotics.RobotStudio.Environment.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Net.Http.WebRequest" />
    <Reference Include="System.Web" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NewtonsoftJsonPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
